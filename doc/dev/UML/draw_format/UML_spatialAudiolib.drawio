        <mxCell id="n_n_fp" value="&lt;b&gt;FileProcessor::process()&lt;/b&gt;&lt;br&gt;read (AudioFormatManager) -&amp;gt; unifyToMono_() -&amp;gt; applyGain_()&lt;br&gt;-&amp;gt; createMd5_() -&amp;gt; SoundFileEntry (id set by Librarian)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8E1;strokeColor=#C9B77A;fontColor=#1A1A1A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="410" width="380" height="64" />
        </mxCell>
        <mxCell id="n_n_ids" value="&lt;b&gt;Shared id space (ReservedIds)&lt;/b&gt;&lt;br&gt;0-9&amp;nbsp;&amp;nbsp;: ambient sounds; ambient emitter id = sound id, always loops&lt;br&gt;10+&amp;nbsp;&amp;nbsp;: registered sounds (Librarian::m_nextId)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;and dynamic emitters (AudioManager::m_nextEmitterId)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8E1;strokeColor=#C9B77A;fontColor=#1A1A1A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="244" width="400" height="78" />
        </mxCell>
        <mxCell id="n_n_json" value="&lt;b&gt;Sound registry JSON&lt;/b&gt; (save / loadSoundRegistry)&lt;br&gt;{ &amp;quot;sounds&amp;quot;:&amp;nbsp;&amp;nbsp;[ { id, md5, filePath } ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;ambient&amp;quot;: [ { id, role, gain, filePath } ] }&lt;br&gt;filePath is relative to the executable folder" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8E1;strokeColor=#C9B77A;fontColor=#1A1A1A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="342" width="300" height="78" />
        </mxCell>
        <mxCell id="n_n_threads" value="&lt;b&gt;Threads&lt;/b&gt;&lt;br&gt;&lt;b&gt;Game thread&lt;/b&gt; (EFView, main.cpp) calls the AudioManager API. Each&lt;br&gt;play / pause / resume / loop / stop / update / reset call pushes&lt;br&gt;one EmitterCommand into m_commandFifo (lock-free, 64 slots).&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;Processing thread&lt;/b&gt; (SpatialAudioEngine::run, juce::Thread) runs&lt;br&gt;drainCommandQueue_() before each block, renders every emitter&lt;br&gt;into m_mixBuffer, then writes it into the CircularStereoBuffer.&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;Audio thread&lt;/b&gt; (AudioCallback) reads the CircularStereoBuffer&lt;br&gt;into the device outputs. It never blocks: silence on underrun." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8E1;strokeColor=#C9B77A;fontColor=#1A1A1A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="1610" width="400" height="176" />
        </mxCell>
        <mxCell id="n_n_path" value="&lt;b&gt;Per-emitter signal path&lt;/b&gt; (SpatialAudioEngine::run, per sample)&lt;br&gt;mono buffer (AudioManager::getBuffer -&amp;gt; Librarian)&lt;br&gt;-&amp;gt; StereoDelayLine: ITD, Thiran fractional delay on the far ear&lt;br&gt;-&amp;gt; FilterChain [active]:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;1. SVFILDFilter: head-shadow LP on the far ear (10 -&amp;gt; 1.5 kHz)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;2. 7 x IIR peak per ear: pinna EQ 4..16 kHz, gains solved&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;so the curve hits the preset values&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;3. CrossoverFilter: per-ear low / mid / high gains (ILDGain):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;front-back level x wall absorption, far ear -3 / -7 dB at 90 deg&lt;br&gt;-&amp;gt; summed into m_mixBuffer; dry mono x reverbSend -&amp;gt; MasterBus send&lt;br&gt;-&amp;gt; MasterBus: shared room reverb added to the mix, then a safety&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;limiter (only acts above 0.95) -&amp;gt; CircularStereoBuffer&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;Pinna change&lt;/b&gt;: setPinnaPreset() -&amp;gt; cmd SetPinnaPreset&lt;br&gt;-&amp;gt; SAE stores m_pinnaPreset, setPinnaEQ() on every shadow (dirty)&lt;br&gt;-&amp;gt; next block: shadow.resetState() + warmUp() -&amp;gt; swap(active, shadow)&lt;br&gt;-&amp;gt; new shadow gets the preset too. Azimuth + gains go to both chains." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8E1;strokeColor=#C9B77A;fontColor=#1A1A1A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="1810" width="430" height="260" />
        </mxCell>
        <mxCell id="n_n_legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background-color:#F5AB50;border:1px solid #909090;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;orange: class&lt;br&gt;&lt;span style=&quot;background-color:#FAD7A0;border:1px solid #909090;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;light orange: struct / enum / namespace&lt;br&gt;&lt;span style=&quot;background-color:#E3E3E3;border:1px solid #909090;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;grey: JUCE base class&lt;br&gt;◆——&amp;nbsp;&amp;nbsp;composition (owner holds the part by value)&lt;br&gt;——&amp;gt;&amp;nbsp;&amp;nbsp;association (holds a reference)&lt;br&gt;- - -&amp;gt;&amp;nbsp;&amp;nbsp;dependency («create» / «use»)&lt;br&gt;——▷&amp;nbsp;&amp;nbsp;inheritance&lt;br&gt;⊕——&amp;nbsp;&amp;nbsp;nested type&lt;br&gt;juce:: and std:: prefixes are omitted for File, String,&lt;br&gt;AudioBuffer, AbstractFifo, SmoothedValue, vector." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8E1;strokeColor=#C9B77A;fontColor=#1A1A1A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2080" y="2322" width="320" height="176" />
        </mxCell>
