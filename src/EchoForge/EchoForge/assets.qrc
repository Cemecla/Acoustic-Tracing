<RCC>
    <qresource prefix="/images">
        <file alias="logo">res/assets/window_logo.png</file>
        <file alias="github">res/assets/github_logo.png</file>
		<file alias="logoRaytracing">res/assets/logo/jaques/idkanymore.png</file>
		<file alias="logoSound">res/assets/logo/yuta/image.png</file>
    </qresource>
    <qresource prefix="/sounds">
        <file alias="buttonSound">res/assets/sounds/MUSCMisc_Major-Short Hover_HY_Trnqlty_01.wav</file>
    </qresource>
    <qresource prefix="/shaders">
        <file>voxel.frag</file>
        <file>voxel.vert</file>
        <file>ray.vert</file>
        <file>ray.frag</file>
    </qresource>
    <qresource prefix="/maps">
        <file alias="reconBotMaps">maps/ReconBot.png</file>
    </qresource>
    <qresource prefix="/meshes">
        <file alias="reconBotMeshes">meshes/defaultobject_mesh.mesh</file>
    </qresource>
    <qresource prefix="/textures">
        <file alias="atlasVoxel">res/assets/atlas/spritesheet_tiles.png</file>
    </qresource>
</RCC>
